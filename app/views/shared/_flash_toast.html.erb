<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <% flash.each do |key, value| %>
    <% 
      is_persistent = key.to_s == 'persistent_warning'
      
      bg_class = case key.to_s
                 when 'notice' then 'text-bg-success'
                 when 'alert' then 'text-bg-danger'
                 when 'warning', 'persistent_warning' then 'text-bg-warning'
                 else 'text-bg-primary'
                 end
      
      # Data attributes for Bootstrap Toast
      toast_options = is_persistent ? 'data-bs-autohide="false"' : 'data-bs-delay="5000"'
    %>
    <div class="toast align-items-center <%= bg_class %> border-0" role="alert" aria-live="assertive" aria-atomic="true" <%= toast_options.html_safe %>>
      <div class="d-flex">
        <div class="toast-body">
          <%= value %>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  <% end %>
</div>

<script>
  (function() {
    const toastElList = document.querySelectorAll('.toast');
    const toastList = [...toastElList].map(toastEl => new bootstrap.Toast(toastEl));
    toastList.forEach(toast => toast.show());
  })();
</script>
