<% content_for :title, "Reservar: #{servicio.titulo}" %>

<div class="container py-5" style="max-width: 850px;">
  <h1 class="fw-bold mb-2 text-center">Reservar servicio</h1>
  <p class="text-muted text-center mb-4">
    Selecciona un horario disponible para tu clase. Luego podrás confirmar y pagar.
  </p>

  <div class="card shadow-sm p-4">
    <div class="p-3 rounded mb-4" style="background:#F9FAFB;">
      <div class="d-flex justify-content-between">
        <h6 class="fw-bold mb-1"><%= servicio.titulo %></h6>
        <span class="fw-bold text-primary"><%= number_to_currency(servicio.precio_base) %></span>
      </div>
      <span class="badge text-dark" style="background:#FBBF24;">
        Duración: <%= servicio.duracion_minutos %> minutos
      </span>
      <p class="small text-muted mt-2"><%= servicio.descripcion %></p>
    </div>

    <% if slots.any? %>
      <div class="mb-3">
        <label class="form-label fw-semibold">Horarios Disponibles</label>
        <select class="form-select" id="slot-selector">
          <option value="">Selecciona un horario...</option>
          <% slots.each do |slot| %>
            <option value="<%= slot.id %>"><%= l(slot.inicio, format: :long) %></option>
          <% end %>
        </select>
      </div>

      <div class="d-flex justify-content-between mt-4">
        <%= link_to "Volver a explorar", servicios_path, class: "btn btn-outline-secondary px-4" %>
        
        <a href="#" class="btn btn-primary px-4 continue-button disabled">
          Continuar a la confirmación
        </a>
      </div>
    <% else %>
      <p class="form-text">No hay horarios disponibles para este servicio en este momento.</p>
      <%= link_to "Volver a explorar", servicios_path, class: "btn btn-outline-secondary px-4 mt-3" %>
    <% end %>
  </div>
</div>

<script>

  (function() {
    const slotSelector = document.getElementById('slot-selector');
    if (!slotSelector) return;

    const continueButton = document.querySelector('.continue-button'); 

    function checkSelection() {
      const slotId = slotSelector.value;
      const isLoggedIn = <%= logged_in? %>;

      if (slotId) {
        continueButton.classList.remove('disabled');

        continueButton.removeAttribute('disabled'); 
        
        const destinationUrl = `/slot_horarios/${slotId}/reservas/new`;
        
        if (isLoggedIn) {
          continueButton.href = destinationUrl;
        } else {
          continueButton.href = `/login?return_to=${encodeURIComponent(destinationUrl)}`;
        }
      } else {
        continueButton.classList.add('disabled');
        continueButton.setAttribute('disabled', 'disabled');
        continueButton.href = '#';
      }
    }

    slotSelector.addEventListener('change', checkSelection);

    checkSelection();
  })();
</script>
