<% content_for :title, "Editar Servicio" %>

<div class="container py-5" style="max-width: 850px;">
  <h1 class="fw-bold mb-2 text-center">Editar Servicio</h1>
  <p class="text-muted text-center mb-4">
    Actualiza los detalles de tu servicio.
  </p>

  <div class="card shadow-sm p-4">
    <%= form_with(model: @servicio, url: servicio_path(@servicio), method: :patch) do |form| %>
      <% if form.object.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0 ps-3">
            <% form.object.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= form.label :titulo, class: "form-label fw-semibold" %>
        <%= form.text_field :titulo, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :descripcion, class: "form-label fw-semibold" %>
        <%= form.text_area :descripcion, class: "form-control", rows: 4 %>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <%= form.label :precio_base, "Precio por hora", class: "form-label fw-semibold" %>
          <%= form.number_field :precio_base, step: 0.01, class: "form-control" %>
        </div>
        <div class="col-md-6 mb-3">
          <%= form.label :duracion_minutos, class: "form-label fw-semibold" %>
          <%= form.number_field :duracion_minutos, class: "form-control" %>
        </div>
      </div>

      <div class="mb-3">
        <%= form.label :modalidad, class: "form-label fw-semibold" %>
        <%= form.select :modalidad, Enums::Modalidad.constants.map { |c| [c.to_s.humanize, Enums::Modalidad.const_get(c)] }, {}, class: "form-select" %>
      </div>

      <div class="mb-3">
        <%= form.label :ubicacion, "Ubicación (solo si es presencial)", class: "form-label fw-semibold" %>
        <%= form.text_field :ubicacion, class: "form-control" %>
      </div>

      <div class="d-flex justify-content-between mt-4">
        <%= link_to "Cancelar", servicio_path(@servicio), class: "btn btn-outline-secondary px-4" %>
        <%= form.submit "Guardar Cambios", class: "btn btn-primary px-4" %>
      </div>
    <% end %>
  </div>
</div>
