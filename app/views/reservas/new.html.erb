<% content_for :title, "Confirmar Reserva" %>

<div class="container py-5" style="max-width: 850px;">
  <h1 class="fw-bold mb-2 text-center">Confirmar tu Reserva</h1>
  <p class="text-muted text-center mb-4">
    Estás a un paso de reservar tu plaza. Por favor, revisa los detalles.
  </p>

  <div class="card shadow-sm p-4">
    <div class="p-3 rounded mb-4" style="background:#F9FAFB;">
      <h6 class="fw-bold mb-1"><%= @servicio.titulo %></h6>
      <p class="small text-muted mt-2 mb-2"><%= @servicio.descripcion %></p>
      <span class="badge text-dark me-2" style="background:#FBBF24;">
        <%= @slot.inicio.strftime("%A, %d de %B, %H:%M") %>
      </span>
      <span class="badge text-dark" style="background:#FBBF24;">
        Duración: <%= @servicio.duracion_minutos %> minutos
      </span>
    </div>

    <div class="mt-2 p-3">
      <h6 class="fw-bold mb-2">Resumen del Costo</h6>
      <div class="d-flex justify-content-between">
        <span>Precio base del servicio:</span>
        <span class="fw-semibold"><%= number_to_currency(@servicio.precio_base) %></span>
      </div>
      <hr>
      <div class="d-flex justify-content-between fw-bold fs-5">
        <span>Total a Pagar:</span>
        <span class="text-primary"><%= number_to_currency(@servicio.precio_base) %></span>
      </div>
    </div>

    <%= form_with(url: slot_horario_reservas_path(@slot), method: :post) do |form| %>
      <%# The client_id is now handled by the controller via current_user %>
      <%= form.hidden_field :service_id, value: @servicio.id %>
      
      <div class="alert alert-info mt-4">
        Al confirmar, se creará una reserva pendiente. Deberás completar el pago en el siguiente paso para asegurarla.
      </div>
      
      <div class="d-flex justify-content-between mt-4">
        <%= link_to "Cancelar", servicio_path(@servicio), class: "btn btn-outline-secondary px-4" %>
        <%= form.submit "Confirmar y Continuar al Pago", class: "btn btn-primary px-4" %>
      </div>
    <% end %>
  </div>
</div>
