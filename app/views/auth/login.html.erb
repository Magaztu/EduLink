<% content_for :title, "EduLink – Iniciar sesión" %>

<div class="edulink-auth-wrapper d-flex align-items-center justify-content-center min-vh-100">
  <div class="card edulink-auth-card">
    <div class="card-body p-4 p-md-5">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
          <div class="edulink-logo-circle"><span>💡</span></div>
          <div class="edulink-brand">
            <span class="edulink-brand-main">Edu</span><span class="edulink-brand-highlight">Link</span>
          </div>
        </div>
        <span class="px-3 py-1 edulink-badge">Plataforma educativa</span>
      </div>

      <h1 class="h4 fw-semibold mb-2">Iniciar sesión</h1>
      <p class="text-muted mb-4">Escribe tu correo y contraseña para acceder a tu cuenta.</p>

      <%# FIX: Display both alert and warning messages %>
      <% if flash.now[:alert] %>
        <div class="alert alert-danger"><%= flash.now[:alert] %></div>
      <% end %>
      <% if flash.now[:warning] %>
        <div class="alert alert-warning"><%= flash.now[:warning] %></div>
      <% end %>

      <%= form_with(url: login_path, method: :post, local: true, scope: :user) do |form| %>
        <div class="mb-3">
          <%= form.label :email, "Correo electrónico", class: "form-label" %>
          <%= form.email_field :email, class: "form-control", placeholder: "tucorreo@ejemplo.com", required: true %>
        </div>

        <div class="mb-3">
          <%= form.label :password, "Contraseña", class: "form-label" %>
          <%= form.password_field :password, class: "form-control", placeholder: "••••••••", required: true %>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3 edulink-remember-row">
          <div class="form-check m-0">
            <%= form.check_box :remember_me, class: "form-check-input" %>
            <%= form.label :remember_me, "Recuérdame", class: "form-check-label" %>
          </div>
          <%= link_to "¿Olvidaste tu contraseña?", new_password_reset_path, class: "edulink-link-secondary text-decoration-none" %>
        </div>

        <%= form.submit "Iniciar sesión", class: "btn btn-primary w-100 mb-3" %>
      <% end %>

      <div class="text-center small text-muted mt-2">
        ¿No tienes una cuenta?
        <%= link_to "Crear cuenta", register_path, class: "edulink-link-primary text-decoration-none" %>
      </div>
    </div>
  </div>
</div>
