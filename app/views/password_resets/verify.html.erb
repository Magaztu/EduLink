<% content_for :title, "Verificar Código" %>

<div class="edulink-auth-wrapper d-flex align-items-center justify-content-center min-vh-100">
  <div class="card edulink-auth-card">
    <div class="card-body p-4 p-md-5">
      <h1 class="h4 fw-semibold mb-3">Verificar Código</h1>
      <p class="text-muted mb-4">Ingresa el código de 6 dígitos que enviamos a tu correo electrónico.</p>

      <%= form_with(url: check_verification_password_reset_path, method: :post, local: true) do |form| %>
        <% if flash[:alert] %>
          <div class="alert alert-danger"><%= flash[:alert] %></div>
        <% end %>
        <% if flash[:notice] %>
          <div class="alert alert-info"><%= flash[:notice] %></div>
        <% end %>

        <div class="mb-3">
          <%= form.label :code, "Código de Verificación", class: "form-label" %>
          <%= form.text_field :code, class: "form-control", required: true, maxlength: 6, pattern: "\\d{6}", inputmode: "numeric" %>
        </div>

        <%= form.submit "Verificar y Continuar", class: "btn btn-primary w-100 mb-3" %>
      <% end %>
    </div>
  </div>
</div>
