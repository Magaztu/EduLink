<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= content_for?(:title) ? yield(:title) : "EduLink" %></title>

  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💡</text></svg>">

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="edulink-body-page">
  
  <nav class="navbar navbar-expand-lg bg-white shadow-sm py-2">
    <div class="container">
      <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-2" do %>
        <%= image_tag "logo.jpg", width: 36, height: 36, alt: "EduLink Logo" %>
        <span class="fw-semibold fs-5">
          <span class="edulink-brand-main">Edu</span><span class="edulink-brand-highlight">Link</span>
        </span>
      <% end %>

      <% if logged_in? %>
        <span class="navbar-text ms-3 d-none d-lg-block fw-medium text-muted">
          Hola, <%= current_user.nombre %>
        </span>
      <% end %>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPublic">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarPublic">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item">
            <%= link_to "Inicio", root_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Explorar", servicios_path, class: "nav-link" %>
          </li>
          <% if logged_in? %>
            <li class="nav-item">
              <%= link_to "Historial", historial_path, class: "nav-link" %>
            </li>
            
            <%# FIX: Usar el método centralizado del modelo %>
            <% if current_user.admin? %>
              <li class="nav-item">
                <%= link_to "Admin", admin_path, class: "nav-link text-danger fw-bold" %>
              </li>
            <% end %>

            <li class="nav-item ms-2">
              <%= button_to "Cerrar sesión", logout_path, method: :delete, class: "btn btn-outline-secondary btn-sm" %>
            </li>
          <% else %>
            <li class="nav-item ms-2">
              <%= link_to "Iniciar sesión", login_path, class: "btn btn-primary px-3 py-1" %>
            </li>
            <li class="nav-item ms-2">
              <%= link_to "Registrarse", register_path, class: "btn btn-warning px-3 py-1" %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </nav>

  <main>
    <%= yield %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  
  <%= render 'shared/flash_toast' %>
</body>
</html>
